<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AgeOfGold' Or '$(MSBuildProjectName)' == 'AgeOfGold.Checks' Or '$(MSBuildProjectName)' == 'Formats' Or '$(MSBuildProjectName)' == 'Havok' Or '$(MSBuildProjectName)' == 'Reflection' Or '$(MSBuildProjectName)' == 'Serialization'">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <RestoreLockedMode Condition="Exists('$(MSBuildProjectDirectory)/packages.lock.json')">true</RestoreLockedMode>
    <PathMap>$(MSBuildThisFileDirectory)=/_source/</PathMap>
  </PropertyGroup>
  <!-- The host shader archive is several hundred megabytes; an eager collector keeps the build within ordinary memory. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AgeOfGold' Or '$(MSBuildProjectName)' == 'AgeOfGold.Checks'">
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'AgeOfGold' Or '$(MSBuildProjectName)' == 'AgeOfGold.Checks'">
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="5368709120" />
  </ItemGroup>
</Project>
