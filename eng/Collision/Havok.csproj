<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HKLib</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>annotations</Nullable>
    <Deterministic>true</Deterministic>
    <LibraryRoot>$(AOG_DEPENDENCIES)/HKLib</LibraryRoot>
    <PathMap>$(PathMap),$(AOG_DEPENDENCIES)=/_dependencies</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LibraryRoot)/HKLib/**/*.cs" Exclude="$(LibraryRoot)/HKLib/obj/**;$(LibraryRoot)/HKLib/bin/**;$(LibraryRoot)/HKLib/hk2018/Autogen/UnitTest/**" />
  </ItemGroup>
</Project>
