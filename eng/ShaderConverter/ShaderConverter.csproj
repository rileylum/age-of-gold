<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HlslDecompiler</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <LibraryRoot>$(AOG_DEPENDENCIES)/HlslDecompiler</LibraryRoot>
    <PathMap>$(MSBuildThisFileDirectory)=/_tool/,$(LibraryRoot)=/_converter/</PathMap>
  </PropertyGroup>
  <Target Name="RequireDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LibraryRoot)/HlslDecompiler.csproj')" Text="Run eng/bootstrap.py outside the repository and set AOG_DEPENDENCIES." />
  </Target>
  <!-- The upstream command-line tool needs no test code, fixtures, resources or NUnit. -->
  <ItemGroup>
    <Compile Include="$(LibraryRoot)/Program.cs;$(LibraryRoot)/DirectXShaderModel/**/*.cs;$(LibraryRoot)/Hlsl/**/*.cs;$(LibraryRoot)/Util/**/*.cs" />
  </ItemGroup>
</Project>
