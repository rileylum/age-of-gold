set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(AOG_LLVM_MINGW "$ENV{AOG_LLVM_MINGW}" CACHE PATH "External pinned LLVM-MinGW distribution")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AOG_LLVM_MINGW)
if(CMAKE_HOST_WIN32)
  set(_aog_exe ".exe")
else()
  set(_aog_exe "")
endif()
set(_aog_cc "${AOG_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang${_aog_exe}")
set(_aog_cxx "${AOG_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++${_aog_exe}")
if(NOT EXISTS "${_aog_cc}" OR NOT EXISTS "${_aog_cxx}")
  message(FATAL_ERROR "Set AOG_LLVM_MINGW to the external compiler pinned in eng/native-toolchain.json")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/native-toolchain.json" _aog_spec)
string(JSON _aog_version GET "${_aog_spec}" clangVersion)
string(JSON _aog_revision GET "${_aog_spec}" llvmRevision)
execute_process(COMMAND "${_aog_cc}" --version RESULT_VARIABLE _aog_result
  OUTPUT_VARIABLE _aog_actual ERROR_VARIABLE _aog_error)
string(FIND "${_aog_actual}" "clang version ${_aog_version} (" _aog_version_at)
string(FIND "${_aog_actual}" "${_aog_revision}" _aog_revision_at)
if(NOT _aog_result EQUAL 0 OR NOT _aog_version_at EQUAL 0 OR _aog_revision_at LESS 0)
  message(FATAL_ERROR "Unsupported LLVM-MinGW compiler; expected ${_aog_version} at ${_aog_revision}")
endif()
set(CMAKE_C_COMPILER "${_aog_cc}")
set(CMAKE_CXX_COMPILER "${_aog_cxx}")
